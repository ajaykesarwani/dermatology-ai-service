# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# ONNX model files (large binary artefacts — store in object storage, not git)
models/*.onnx
models/*.onnx.data
models/*_preprocessed.onnx

# Allow the quantized INT8 model to be tracked (only ~11MB) so cloud deployments like Render can use it
!models/resnet18_quant_int8.onnx

# Jupyter
*.ipynb_checkpoints/
.ipynb_checkpoints/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.suo
*.user

# .NET build artefacts
client/**/bin/
client/**/obj/

# Docker
.dockerignore

# Misc
*.jfif
*.tmp
*.bak
images.jfif
*.pth

# Fix #15 — also ignore WebP images dropped into the project root during testing
*.webp
